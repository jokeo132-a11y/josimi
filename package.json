{
  "name": "monejo",
  "version": "0.6.0",
  "description": "monejo — non-custodial Monero wallet",
  "main": "src/main.js",
  "author": "monejo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "monero-ts": "0.11.20",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.monejo.wallet",
    "productName": "monejo",
    "artifactName": "monejo-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "monejo.${ext}"
    }
  }
}
