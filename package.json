{
  "name": "josimi",
  "version": "1.2.10",
  "description": "josimi — non-custodial Monero wallet",
  "main": "src/main.js",
  "author": "josimi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/core.js && node --check scripts/prepare-monero-runtime.js && node --check scripts/cleanup-monero-runtime.js && node --check scripts/build-windows.js && node --check scripts/build-website.js && node --test --test-concurrency=1",
    "dist": "node scripts/build-windows.js",
    "build:site": "node scripts/build-website.js"
  },
  "dependencies": {
    "monero-ts": "0.11.20",
    "qrcode": "1.5.4"
  },
  "overrides": {
    "serialize-javascript": "7.1.3",
    "uuid": "11.1.1",
    "ip-address": "10.7.4",
    "follow-redirects": "1.16.2",
    "minimatch": "11.0.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.josimi.wallet",
    "productName": "josimi",
    "icon": "assets/josimi.ico",
    "asarUnpack": [
      "assets/runtime/monero/**/*"
    ],
    "artifactName": "josimi-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "licenses/monero/LICENSE.txt",
      "assets/josimi.ico",
      "assets/josimi-logo.png",
      "assets/runtime/monero/**/*"
    ],
    "win": {
      "target": "zip"
    }
  }
}
