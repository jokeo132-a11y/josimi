{
  "name": "josimi",
  "version": "1.2.0",
  "description": "josimi — non-custodial Monero wallet",
  "main": "src/main.js",
  "author": "josimi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/core.js && node --test",
    "dist": "electron-builder --win portable zip"
  },
  "dependencies": {
    "monero-ts": "0.11.21",
    "qrcode": "1.5.4"
  },
  "overrides": {
    "serialize-javascript": "7.1.3",
    "uuid": "11.1.1",
    "ip-address": "10.7.4"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.josimi.wallet",
    "productName": "josimi",
    "icon": "assets/josimi.ico",
    "asarUnpack": [
      "assets/runtime/**/*"
    ],
    "artifactName": "josimi-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json",
      "assets/josimi.ico",
      "assets/runtime/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "josimi.${ext}"
    }
  }
}
